# Client-uploaded files are served exclusively through authenticated
# Laravel routes (FileDownloadController) now, which check the request
# belongs to the file's owner or an admin before streaming it from this
# same on-disk location. Deny all direct access to this directory, on any
# Apache-served deployment, so that auth check can't be bypassed via the
# raw URL.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
